# ============================================================
#  ARBALIST CAPITAL — Environment Variables
#  Copy this to .env and fill in your real values
#  NEVER commit .env to git!
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Paystack ──────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developer
# Use pk_test_ for dev, pk_live_ for production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────
VITE_APP_NAME=Arbalist Capital
VITE_APP_URL=https://www.arbalistcapital.com.ng
